# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Instagram Professional account (Instagram Login flow)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=v23.0

# Public base URL where rendered JPEGs are reachable.
# Example: https://your-project.vercel.app
PUBLIC_BASE_URL=

# Safety: keep true until you intentionally enable auto-publishing.
DRY_RUN=true
